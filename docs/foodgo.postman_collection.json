    {
      "name": "Order",
      "item": [
        {
          "name": "Dat hang (COD)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('clientRequestId')) {",
                  "  pm.collectionVariables.set('clientRequestId', pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const id = body.orderId || (body.order && body.order._id);",
                  "if (id) pm.collectionVariables.set('orderId', id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientRequestId\": \"{{clientRequestId}}\",\n  \"paymentMethod\": \"cod\",\n  \"items\": [\n    { \"foodId\": \"{{foodId}}\", \"quantity\": 2 }\n  ],\n  \"address\": {\n    \"fullName\": \"Khach demo\",\n    \"phone\": \"0900000000\",\n    \"address\": \"1 Duong ABC\",\n    \"note\": \"Giao gio hanh chinh\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "order"
              ]
            },
            "description": "Gui lai cung clientRequestId se tra ve dung don cu (idempotent), khong tao don trung. Server tu tra gia tu DB, so tien client gui len bi bo qua."
          }
        },
        {
          "name": "Kiem tra don theo clientRequestId",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/order/request/{{clientRequestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "order",
                "request",
                "{{clientRequestId}}"
              ]
            }
          }
        },
        {
          "name": "Don cua toi (phan trang + loc trang thai)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/order/my?page=1&limit=10&status=pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "order",
                "my"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          }
        },
        {
          "name": "Chi tiet don",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/order/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "order",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "Huy don (khach)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Doi y khong mua nua\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/order/{{orderId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "order",
                "{{orderId}}",
                "cancel"
              ]
            },
            "description": "Chi huy duoc khi don o pending hoac confirmed."
          }
        },
        {
          "name": "Tao thanh toan VNPay",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/order/{{orderId}}/vnpay/create-payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "order",
                "{{orderId}}",
                "vnpay",
                "create-payment"
              ]
            },
            "description": "Tra ve payUrl de mo trong trinh duyet. Can cac bien VNPAY_* trong .env (sandbox)."
          }
        },
        {
          "name": "Toan bo don (admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/order/list?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "order",
                "list"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Doi trang thai don (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/order/{{orderId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "order",
                "{{orderId}}",
                "status"
              ]
            },
            "description": "Chi di theo pending -> confirmed -> shipped -> delivered. Tra 409 neu trang thai da bi nguoi khac doi truoc."
          }
        },
        {
          "name": "Thong ke doanh thu (admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/order/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "order",
                "stats"
              ]
            }
          }
        }
      ]
    },
