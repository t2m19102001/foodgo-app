# Copy file nay thanh .env roi dien gia tri that. KHONG commit file .env
PORT=5000

# Chuoi ket noi PostgreSQL. Vi du Neon:
# postgres://<user>:<password>@<host>.neon.tech/foodgo?sslmode=require
#
# Neon cho 2 dang chuoi: TRUC TIEP va POOLED (host co them "-pooler"). Dung ban
# TRUC TIEP cho ca app lan migration/seed - app nay la mot Express chay lien tuc
# va tu quan ly pool bang pg.Pool, con migration thi can session-level state nen
# bat buoc phai di truc tiep. Chi doi sang ban -pooler khi nao chay nhieu
# instance cung luc.
#
# Hoac Postgres chay local (nho dat PGSSL=disable ben duoi):
# postgres://postgres@127.0.0.1:5432/foodgo
DATABASE_URL=

# Dat 'disable' khi chay Postgres local khong co TLS. De trong khi dung Neon.
PGSSL=
# So connection toi da trong pool, de trong thi mac dinh 10
PG_POOL_MAX=

# Chuoi ket noi MongoDB - chi con dung cho scripts/migrate-from-mongo.mjs khi
# chuyen du lieu cu sang Postgres. Xoa sau khi da chuyen xong.
MONGO_URI=

# Chuoi bi mat de ky JWT, dat mot chuoi dai va ngau nhien
JWT_SECRET=

NODE_ENV=development
CORS_ORIGINS=

# Tai khoan merchant sandbox VNPay (dang ky mien phi tai https://sandbox.vnpayment.vn/devreg/)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# URL cong thanh toan sandbox, dung chung cho moi merchant, khong can doi
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# URL VNPay redirect trinh duyet ve sau khi thanh toan - gia tri mac dinh danh cho emulator
VNPAY_RETURN_URL=http://10.0.2.2:5000/api/order/vnpay/return
