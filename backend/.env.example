# Copy file nay thanh .env roi dien gia tri that. KHONG commit file .env
PORT=5000

# Chuoi ket noi PostgreSQL. Vi du Neon:
# postgres://<user>:<password>@<host>.neon.tech/foodgo?sslmode=require
#
# Neon cho 2 dang chuoi: TRUC TIEP va POOLED (host co them "-pooler"). Dung ban
# TRUC TIEP cho ca app lan migration/seed - app nay la mot Express chay lien tuc
# va tu quan ly pool bang pg.Pool, con migration thi can session-level state nen
# bat buoc phai di truc tiep. Chi doi sang ban -pooler khi nao chay nhieu
# instance cung luc.
#
# Hoac Postgres chay local (nho dat PGSSL=disable ben duoi):
# postgres://postgres@127.0.0.1:5432/foodgo
DATABASE_URL=

# Dat 'disable' khi chay Postgres local khong co TLS. De trong khi dung Neon.
PGSSL=
# So connection toi da trong pool, de trong thi mac dinh 10
PG_POOL_MAX=

# Chuoi bi mat de ky JWT, dat mot chuoi dai va ngau nhien
JWT_SECRET=

NODE_ENV=development
CORS_ORIGINS=

# Tai khoan merchant sandbox VNPay (dang ky mien phi tai https://sandbox.vnpayment.vn/devreg/)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# URL cong thanh toan sandbox, dung chung cho moi merchant, khong can doi
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# URL VNPay redirect trinh duyet ve sau khi thanh toan - gia tri mac dinh danh cho emulator
VNPAY_RETURN_URL=http://10.0.2.2:5000/api/order/vnpay/return
# Thoi gian (phut) VNPay chap nhan thanh toan cho mot payUrl (vnp_ExpireDate). Mac dinh 15
VNPAY_PAYMENT_TTL_MINUTES=
# Cho them (phut) sau han thanh toan truoc khi tu huy don va hoan kho, de IPN den tre
# van duoc ghi nhan. Mac dinh 15
VNPAY_EXPIRY_GRACE_MINUTES=

# ===== ZaloPay (dang ky sandbox tai https://docs.zalopay.vn) =====
# app_id cua merchant sandbox
ZALOPAY_APP_ID=
# Mac Key dung de ky don khi tao (tao mac cho API /v2/create)
ZALOPAY_KEY1=
# Key dung de xac thuc callback ZaloPay gui ve (KHAC key1)
ZALOPAY_KEY2=
# CHUA xac minh 100% dung URL sandbox - kiem tra lai tai docs.zalopay.vn khi
# co tai khoan that. Mac dinh gia tri pho bien hien tai:
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
# URL ZaloPay goi ve khi thanh toan xong (server-to-server, khong phai trinh
# duyet khach) - de trong neu test local khong co domain cong khai
ZALOPAY_CALLBACK_URL=

# ===== Google Maps (vi tri nha hang) =====
# Toa do THAT cua nha hang - FoodGo chi co 1 cua hang nen khong can bang DB.
# Lay toa do bang cach bam giu tren Google Maps roi copy so hien ra.
RESTAURANT_LAT=
RESTAURANT_LNG=
RESTAURANT_NAME=FoodGo

# ===== Smart ETA (du tinh thoi gian chuan bi + giao hang, rule-based, KHONG ML) =====
# Khong co GPS/khoang cach thuc nen "giao hang" la mot khoang trung binh cau
# hinh duoc, gop luon ca thoi gian cho tai xe toi lay - xem backend/util/eta.js
#
# Thoi gian trung binh nha hang xac nhan don (phut). Mac dinh 5
ETA_CONFIRM_MINUTES=
# Phu phi chuan bi cho MOI mon khac nhau tu mon thu 2 tro di (phut). Mac dinh 2
ETA_PREP_EXTRA_ITEM_MINUTES=
# Tran thoi gian chuan bi du don nhieu mon / tai cao the nao (phut). Mac dinh 60
ETA_PREP_MAX_MINUTES=
# Thoi gian giao hang trung binh, gop ca thoi gian cho tai xe toi lay (phut). Mac dinh 20
ETA_DELIVERY_MINUTES=
# So don active (pending/confirmed) toi da de con coi la tai THAP (he so x1). Mac dinh 5
ETA_LOAD_LOW_THRESHOLD=
# So don active toi da de con coi la tai TRUNG BINH; vuot nguong nay la tai CAO. Mac dinh 15
ETA_LOAD_MEDIUM_THRESHOLD=
# He so nhan vao thoi gian chuan bi khi tai TRUNG BINH. Mac dinh 1.2
ETA_LOAD_MEDIUM_FACTOR=
# He so nhan vao thoi gian chuan bi khi tai CAO. Mac dinh 1.5
ETA_LOAD_HIGH_FACTOR=
# Chenh lech (phut) giua uoc tinh tinh lai va uoc tinh luc dat hang de canh bao
# khach la co the bi tre. Mac dinh 10
ETA_SIGNIFICANT_CHANGE_MINUTES=

# ===== AI Chatbot + AI Search (OpenAI Chat Completions API, hoac bat ky
# provider nao tuong thich format nay - Groq, OpenRouter...) =====
# Lay tai https://platform.openai.com/api-keys (can tai khoan co credit/billing)
# hoac doi sang Groq (mien phi, khong can the): https://console.groq.com/keys
OPENAI_API_KEY=
# QUAN TRONG: danh sach model doi theo thoi gian. Kiem tra model con dang
# dung truoc khi dien tai https://platform.openai.com/docs/models (OpenAI)
# hoac https://console.groq.com/docs/models (Groq, vd "llama-3.3-70b-versatile").
OPENAI_MODEL=
# De trong de dung OpenAI. Doi sang Groq: https://api.groq.com/openai/v1
OPENAI_API_BASE=https://api.openai.com/v1
# So tin nhan chat toi da / 10 phut / user - kiem soat chi phi goi LLM. Mac dinh 20
CHAT_RATE_LIMIT_MAX=
# So lan goi AI Search toi da / 10 phut / IP. Mac dinh 30
AI_SEARCH_RATE_LIMIT_MAX=

# ===== SMTP (gui email quen mat khau) =====
# Vi du Gmail: host smtp.gmail.com, port 587, user la dia chi Gmail, pass la
# APP PASSWORD (khong phai mat khau Gmail thuong - tao tai
# https://myaccount.google.com/apppasswords, can bat 2-Step Verification truoc).
# Chua dien thi server CHI ghi ma dat lai mat khau ra log, khong gui mail that.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# De trong se dung SMTP_USER lam dia chi gui
SMTP_FROM=
