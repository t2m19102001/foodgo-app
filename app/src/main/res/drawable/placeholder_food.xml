<?xml version="1.0" encoding="utf-8"?>
<!-- Anh cho khi tai/loi anh mon an: nen xam nhat, icon nho o giua.
     Kich thuoc goc lon (200dp) de khi ImageView centerCrop, icon khong bi phong to qua muc. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background_light" />
            <size
                android:width="200dp"
                android:height="200dp" />
        </shape>
    </item>
    <item
        android:width="44dp"
        android:height="44dp"
        android:drawable="@drawable/ic_logo_muted"
        android:gravity="center" />
</layer-list>
